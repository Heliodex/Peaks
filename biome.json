{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"assist": {
		"actions": {
			"source": {
				"noDuplicateClasses": "on",
				"organizeImports": "on",
				"useSortedAttributes": "on",
				"useSortedEnumMembers": "on",
				"useSortedInterfaceMembers": "on",
				"useSortedKeys": "on",
				"useSortedPackageJson": "on",
				"useSortedProperties": "on",
				"useSortedSelectionSet": "on",
				"useSortedTypeFields": "on"
			}
		},
		"enabled": true
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"files": {
		"includes": [
			"src/**",
			"tests/**",
			"*.config.js",
			"*.config.ts",
			"*.json"
		]
	},
	"formatter": {
		"indentWidth": 4
	},
	"html": {
		"experimentalFullSupportEnabled": true,
		"formatter": {
			"enabled": true
		}
	},
	"javascript": {
		"formatter": {
			"arrowParentheses": "asNeeded",
			"bracketSameLine": false,
			"operatorLinebreak": "before",
			"semicolons": "asNeeded",
			"trailingCommas": "all"
		}
	},
	"linter": {
		"rules": {
			"a11y": {
				"noNoninteractiveElementInteractions": "off"
			},
			"complexity": {
				"noDivRegex": "off",
				"noExcessiveCognitiveComplexity": "off",
				"noExcessiveLinesPerFunction": "off",
				"noVoid": "off",
				"useMaxParams": "off",
				"useSimplifiedLogicExpression": "off"
			},
			"correctness": {
				"noComponentHookFactories": "off",
				"noUndeclaredVariables": "off",
				"noUnresolvedImports": "off",
				"useImportExtensions": "off",
				"useQwikValidLexicalScope": "off"
			},
			"nursery": {
				"noAccidentalBitwiseOperators": "error",
				"noArgumentsCallerOrCallee": "error",
				"noArraySortForMinMax": "error",
				"noAstroConflictingSetDirectives": "error",
				"noAstroSetHtmlDirective": "error",
				"noBaseToString": "error",
				"noBooleanSortComparator": "error",
				"noDoubleComparison": "error",
				"noDuplicateMapKeys": "error",
				"noEagerArrayMethodsInLoops": "error",
				"noExtendNative": "error",
				"noFloatingPromises": "error",
				"noImpliedEval": "error",
				"noInvalidFileInputAccept": "error",
				"noInvalidPropertyInitValue": "error",
				"noInvalidThis": "error",
				"noJsonUnsafeValues": "error",
				"noJsRestrictedProperties": "error",
				"noMeaninglessVoidOperator": "error",
				"noMisplacedListElements": "error",
				"noNegationInEqualityCheck": "error",
				"noNestedSwitch": "error",
				"noNestedTemplateLiterals": "error",
				"noNewRequire": "error",
				"noNonScalableViewport": "error",
				"noObjectConstructor": "error",
				"noObsoleteAttributes": "error",
				"noObsoleteTags": "error",
				"noOctal": "error",
				"noPathConcat": "error",
				"noPlaywrightNthMethods": "error",
				"noProcessExit": "error",
				"noReactObjectTypeAsDefaultProp": "error",
				"noRestrictedDependencies": "error",
				"noReturnInFinally": "error",
				"noSelfImport": "error",
				"noSelfNestedLayer": "error",
				"noShortTimeValues": "error",
				"noSvelteAtDebugTags": "error",
				"noSvelteAtHtmlTags": "error",
				"noSvelteExportLet": "error",
				"noSvelteInspect": "error",
				"noSvelteInternal": "error",
				"noSvelteLegacyConst": "error",
				"noSvelteObjectInTextMustaches": "error",
				"noSvelteUnnecessaryStateWrap": "error",
				"noSvelteUselessDerivedBy": "error",
				"noTailwindLegacyUtilities": "error",
				"noTailwindRestyledComponents": "error",
				"noTanstackQueryRestDestructuring": "error",
				"noThisOutsideOfClass": "error",
				"noUnmodifiedLoopCondition": "error",
				"noUnsafeIframeSandbox": "error",
				"noUnsafePlusOperands": "error",
				"noUnsafeReturn": "error",
				"noUnsafeUnaryMinus": "error",
				"noUselessCall": "error",
				"noUselessDateGetTime": "error",
				"noUselessSplice": "error",
				"noUselessTypeConversion": "error",
				"noVueBooleanDefault": "error",
				"noVueDeprecatedScopedSlots": "error",
				"noVueLifecycleAfterAwait": "error",
				"noVueRequiredPropWithDefault": "error",
				"noVueRootVIf": "error",
				"noVueShadowNativeEvents": "error",
				"noVueUndeclaredDirectives": "error",
				"noVueUnusedEmitDeclarations": "error",
				"noVueVHtml": "error",
				"noVueVText": "error",
				"noVueVTextVHtmlOnComponent": "error",
				"noVueWatchAfterAwait": "error",
				"noXorAsExponentiation": "error",
				"noZeroFractions": "error",
				"noZeroLengthUnit": "error",
				"useAstroClientOnlyDirectiveValue": "error",
				"useAwaitThenable": "error",
				"useBetterDomTraversing": "error",
				"useBigintLiterals": "error",
				"useBlockStatementOverIife": "error",
				"useConsistentBlockLang": "error",
				"useConsistentHeadingLevel": "error",
				"useConsistentJsonFileRead": "error",
				"useConsistentLightnessNotation": "error",
				"useConsistentObjectKeys": "error",
				"useConsistentUnicodeBom": "error",
				"useControlLabel": "error",
				"useExhaustiveSwitchCases": "error",
				"useExpectToContain": "error",
				"useFencedCodeLanguage": "error",
				"useFlatMathMinMax": "error",
				"useIncludes": "error",
				"useIteratorZip": "error",
				"useMatchingFunctionName": "error",
				"useMathAbs": "error",
				"useMathTrunc": "error",
				"useModernMathApis": "error",
				"useNamedFunction": "error",
				"useNamedLayer": "error",
				"usePackageJsonValidCpu": "error",
				"usePackageJsonValidEngines": "error",
				"usePromiseRejectErrors": "error",
				"useReactCompiler": "error",
				"useReactFunctionComponentDefinition": "error",
				"useReactNamingConvention": "error",
				"useReactNativeValidPlatformColors": "error",
				"useRegexpExec": "error",
				"useSingleTopLevelHeading": "error",
				"useStringStartsEndsWith": "error",
				"useSvelteKitRuneImports": "error",
				"useSvelteReactiveClasses": "error",
				"useSvelteRequireEachKey": "error",
				"useSvelteShorthandDirective": "error",
				"useTopLevelHeading": "error",
				"useUnaryMinus": "error",
				"useValidTestTitle": "error",
				"useVueBaseImport": "error",
				"useVueComponentIs": "error",
				"useVueConsistentEventHyphenation": "error",
				"useVueMatchingComponentFileName": "error",
				"useVueToggleInsideTransition": "error",
				"useVueTypedRef": "error",
				"useVueVOnExact": "error"
			},
			"performance": {
				"noAwaitInLoops": "off",
				"noBarrelFile": "off",
				"noDelete": "off",
				"useTopLevelRegex": "off"
			},
			"preset": "all",
			"security": {
				"noSecrets": "off"
			},
			"style": {
				"noContinue": "off",
				"noDefaultExport": "off",
				"noExcessiveClassesPerFile": "off",
				"noExcessiveLinesPerFile": "off",
				"noHexColors": "off",
				"noIncrementDecrement": "off",
				"noInlineStyles": "off",
				"noMagicNumbers": "off",
				"noNamespace": "off",
				"noNegationElse": "off",
				"noNestedTernary": "off",
				"noParameterProperties": "off",
				"noRestrictedGlobals": "off",
				"noTernary": "off",
				"useBlockStatements": "off",
				"useConsistentBuiltinInstantiation": "off",
				"useConsistentMethodSignatures": "off",
				"useConsistentTestIt": "off",
				"useDestructuring": "off",
				"useErrorCause": "off",
				"useExportsLast": "off",
				"useFilenamingConvention": "off",
				"useGlobalThis": "off",
				"useNamedCaptureGroup": "off",
				"useNamingConvention": "off",
				"useNumericSeparators": "off",
				"useReadonlyClassProperties": "off",
				"useTestHooksInOrder": "off",
				"useThisInClassMethods": "off",
				"useUnicodeRegex": "off"
			},
			"suspicious": {
				"noConsole": "off",
				"noEmptyBlockStatements": "off",
				"noLoopFunc": "off",
				"noReturnAssign": "off",
				"noShadow": "off",
				"noUnassignedVariables": "off",
				"noUnnecessaryConditions": "off",
				"useBaseline": "off",
				"useExpect": "off"
			}
		}
	},
	"overrides": [
		{
			"assist": {
				"actions": {
					"source": {
						"useSortedKeys": "off"
					}
				}
			},
			"includes": ["package.json"]
		},
		{
			"includes": ["**/*.svelte"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedLabels": "off",
						"noUnusedVariables": "off"
					},
					"style": {
						"useConst": "off"
					},
					"suspicious": {
						"noConfusingLabels": "off",
						"noEvolvingTypes": "off",
						"noImplicitAnyLet": "off"
					}
				}
			}
		}
	]
}
