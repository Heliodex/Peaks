{
	"name": "peaks",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"build": "vite build",
		"buildview": "vite build && vite preview",
		"dev": "vite dev",
		"lint": "oxlint && biome check",
		"lint:fix": "oxlint --fix && biome check --fix",
		"prepare": "svelte-kit sync || echo ''",
		"preview": "vite preview",
		"svelte:check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"svelte:check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "bun test"
	},
	"dependencies": {
		"@sveltejs/kit": "next",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"arktype": "^2.2.9",
		"mp4-muxer": "^5.2.2",
		"mp4box": "^2.5.0",
		"svelte": "^5.57.2",
		"tailwindcss": "^4.3.3",
		"vite": "^8.3.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@sveltejs/adapter-static": "^4.0.1",
		"@types/bun": "^1.4.4",
		"@typescript/native": "npm:typescript@^7.0.2",
		"oxlint": "^1.89.0",
		"oxlint-tsgolint": "^7.0.2005",
		"svelte-check": "^4.7.7",
		"typescript": "~6.0.3"
	}
}
